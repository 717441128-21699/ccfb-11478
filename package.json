{
  "name": "dp-release-tool",
  "version": "0.1.0",
  "description": "浏览器端差分隐私统计发布工具(原始数据不出本机)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen": "npm run build && node dist/scripts/gen-population.js",
    "verify": "npm run build && node dist/scripts/verify-dp.js",
    "serve": "npm run build && node scripts/serve.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  }
}
